# Abrahamic: the readme and the documentation are for the site's editors and
# are not served to visitors, search engines or crawlers.
<FilesMatch "^(readme\.txt|.*\.md)$">
	<IfModule mod_authz_core.c>
		Require all denied
	</IfModule>
	<IfModule !mod_authz_core.c>
		Order allow,deny
		Deny from all
	</IfModule>
</FilesMatch>

# The .claude folder holds notes for contributors. It never ships, and is
# never served if a working copy is uploaded.
<IfModule mod_alias.c>
	RedirectMatch 404 /\.claude(/|$)
</IfModule>
