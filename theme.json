      "fontSizes": [
        {
          "slug": "small",
          "name": "Small",
          "size": "0.95rem"
        },
        {
          "slug": "medium",
          "name": "Medium",
          "size": "1.1875rem",
          "fluid": {
            "min": "1.125rem",
            "max": "1.1875rem"
          }
        },
        {
          "slug": "large",
          "name": "Large",
          "size": "1.4rem",
          "fluid": {
            "min": "1.25rem",
            "max": "1.4rem"
          }
        },
        {
          "slug": "x-large",
          "name": "Extra Large",
          "size": "2.8rem",
          "fluid": {
            "min": "2rem",
            "max": "2.8rem"
          }
        },
        {
          "slug": "xx-large",
          "name": "Display",
          "size": "4.6rem",
          "fluid": {
            "min": "2.9rem",
            "max": "4.6rem"
          }
        }
      ]
    },
    "spacing": {
      "units": [
        "px",
        "rem",
        "%",
        "vw"
      ]
    }
  },
  "styles": {
    "color": {
      "background": "var:preset|color|ivory",
      "text": "var:preset|color|charcoal"
    },
    "typography": {
      "fontFamily": "var:preset|font-family|sabon",
      "fontSize": "var:preset|font-size|medium",
      "lineHeight": "1.65",
      "fontWeight": "400"
    },
    "spacing": {
      "blockGap": "1.25rem",
      "padding": {
        "left": "clamp(20px, 4vw, 40px)",
        "right": "clamp(20px, 4vw, 40px)"
      }
    },
    "elements": {
      "heading": {
        "color": {
          "text": "var:preset|color|navy"
        },
        "typography": {
          "fontFamily": "var:preset|font-family|sabon",
          "fontWeight": "400",
          "lineHeight": "1.12"
        }
      },
      "h1": {
        "typography": {
          "fontSize": "var:preset|font-size|xx-large",
          "lineHeight": "1.04",
          "letterSpacing": "-0.015em"
        }
      },
      "h2": {
        "typography": {
          "fontSize": "var:preset|font-size|x-large"
        }
      },
      "link": {
        "color": {
          "text": "var:preset|color|navy"
        },
        ":hover": {
          "color": {
            "text": "var:preset|color|gold"
          }
        }
      },
      "button": {
        "color": {
          "background": "var:preset|color|navy",
          "text": "var:preset|color|white"
        },
        "border": {
          "radius": "4px"
        },
        "typography": {
          "fontFamily": "var:preset|font-family|sabon",
          "fontSize": "1rem",
          "fontWeight": "700",
          "letterSpacing": "0.03em"
        },
        "spacing": {
          "padding": {
            "top": "13px",
            "bottom": "13px",
            "left": "32px",
            "right": "32px"
          }
        },
        ":hover": {
          "color": {
            "background": "#1f2a44",
            "text": "var:preset|color|white"
          }
        }
      }
    },
    "blocks": {
      "core/navigation": {
        "typography": {
          "fontSize": "1rem",
          "fontWeight": "400"
        }
      },
      "core/details": {
        "border": {
          "bottom": {
            "color": "var:preset|color|beige",
            "width": "1px"
          }
        }
      },
      "core/quote": {
        "typography": {
          "fontWeight": "400"
        }
      },
      "core/pullquote": {
        "typography": {
          "fontWeight": "400"
        }
      }
    }
  },
  "templateParts": [
    {
      "name": "header",
      "title": "Header",
      "area": "header"
    },
    {
      "name": "footer",
      "title": "Footer",
      "area": "footer"
    }
  ],
  "customTemplates": [
    {
      "name": "page-landing",
      "title": "Landing (full width, no title)",
      "postTypes": [
        "page"
      ]
    }
  ]
}
